            }
        ];

        // Зберігаємо книги у localStorage або використовуємо початкові
        let books = JSON.parse(localStorage.getItem('books')) || initialBooks;

        // Функція для відображення книг
        function displayBooks() {
            const booksContainer = document.getElementById('books-container');
            booksContainer.innerHTML = '';

            books.forEach(book => {
                const bookCard = document.createElement('div');
                bookCard.className = 'book-card';
                
                // Створюємо рейтинг у вигляді зірочок
                let stars = '';
                for (let i = 1; i <= 5; i++) {
                    stars += <i class="fas fa-star ${i <= book.rating ? 'active' : ''}"></i>;
                }
                
                // Створюємо теги жанрів
                let genreTags = '';
                if (Array.isArray(book.genre)) {
                    book.genre.forEach(genre => {
                        genreTags += <span class="book-genre">${genre}</span>;
                    });
                } else {
                    genreTags = <span class="book-genre">${book.genre}</span>;
                }
                
                bookCard.innerHTML = `
                    <img src="${book.image}" alt="${book.title}" class="book-image">
                    <div class="book-info">
                        <h3 class="book-title">${book.title}</h3>
                        <p class="book-author">${book.author}</p>
                        <div class="book-rating">${stars}</div>
                        <p class="book-description">${book.description}</p>
                        <div>${genreTags}</div>
                    </div>
                `;
                
                booksContainer.appendChild(bookCard);
            });
            
            // Зберігаємо книги у localStorage
            localStorage.setItem('books', JSON.stringify(books));
        }

        // Функція для додавання нової книги
        function addBook(event) {
            event.preventDefault();
            
            const title = document.getElementById('title').value;
            const author = document.getElementById('author').value;
            const description = document.getElementById('description').value;
            const genre = document.getElementById('genre').value;
            const rating = parseInt(document.getElementById('rating').value);
            const image = document.getElementById('image').value || 'https://images.unsplash.com/photo-1541963463532-d68292c34b19?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80';
            
            const newBook = {
                id: books.length + 1,
                title,
                author,
                description,
                genre: [genre],
                rating,
                image
            };
            
            books.push(newBook);
            displayBooks();
            
            // Очищаємо форму
            document.getElementById('book-form').reset();
            document.getElementById('rating').
value = 5;
            
            // Оновлюємо зірочки рейтингу
            const stars = document.querySelectorAll('.rating-input i');
            stars.forEach(star => {
                star.classList.remove('active');
                if (parseInt(star.getAttribute('data-value')) <= 5) {
                    star.classList.add('active');
                }
            });
            
            // Прокручуємо до списку книг
            document.getElementById('books-list').scrollIntoView({ behavior: 'smooth' });
            
            alert('Книгу успішно додано до колекції!');
        }

        // Обробник рейтингу (зірочки)
        document.querySelectorAll('.rating-input i').forEach(star => {
            star.addEventListener('click', function() {
                const value = parseInt(this.getAttribute('data-value'));
                document.getElementById('rating').value = value;
                
                // Оновлюємо вигляд зірочок
                document.querySelectorAll('.rating-input i').forEach(s => {
                    if (parseInt(s.getAttribute('data-value')) <= value) {
                        s.classList.add('active');
                    } else {
                        s.classList.remove('active');
                    }
                });
            });
        });

        // Ініціалізація при завантаженні сторінки
        document.addEventListener('DOMContentLoaded', function() {
            displayBooks();
            
            // Додаємо обробник для форми
            document.getElementById('book-form').addEventListener('submit', addBook);
            
            // Встановлюємо активні зірочки рейтингу за замовчуванням
            const stars = document.querySelectorAll('.rating-input i');
            stars.forEach(star => {
                if (parseInt(star.getAttribute('data-value')) <= 5) {
                    star.classList.add('active');
                }
            });
        });
    </script>
